{
    "info": {
        "name": "Social Media Clone API (Sanctum, Policies, Soft Delete)",
        "_postman_id": "3b6d8b3a-7c9f-4c34-9a0b-aaa000111222",
        "description": "Laravel Sanctum Token Auth — Signup, Login (captures token), Create Post (captures id), List/Show, Update, Delete (soft), Restore.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Signup",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "pm.test('Status is 201 or 200', function () {",
                            "  pm.expect(pm.response.code).to.be.oneOf([200,201]);",
                            "});",
                            "pm.test('Response includes token', function () {",
                            "  pm.expect(json).to.have.property('token');",
                            "});",
                            "if (json.token) {",
                            "  pm.collectionVariables.set('token', json.token);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Ali Ahmed\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"Secret123!\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/signup",
                    "host": [ "{{baseUrl}}" ],
                    "path": [ "api", "signup" ]
                }
            },
            "response": []
        },
        {
            "name": "Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "pm.test('Status is 200', function () {",
                            "  pm.expect(pm.response.code).to.eql(200);",
                            "});",
                            "pm.test('Response includes token', function () {",
                            "  pm.expect(json).to.have.property('token');",
                            "});",
                            "if (json.token) {",
                            "  pm.collectionVariables.set('token', json.token);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"ali@example.com\",\n  \"password\": \"Secret123!\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/login",
                    "host": [ "{{baseUrl}}" ],
                    "path": [ "api", "login" ]
                }
            },
            "response": []
        },
        {
            "name": "Create Post",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "pm.test('Status is 201 or 200', function () {",
                            "  pm.expect(pm.response.code).to.be.oneOf([200,201]);",
                            "});",
                            "// Try to capture ID from common response shapes",
                            "let id = json.id || (json.post && json.post.id) || (Array.isArray(json) && json[0] && json[0].id) || null;",
                            "if (id) {",
                            "  pm.collectionVariables.set('id', id);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"My First Post\",\n  \"body\": \"Hello World!\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/posts",
                    "host": [ "{{baseUrl}}" ],
                    "path": [ "api", "posts" ]
                }
            },
            "response": []
        },
        {
            "name": "List Posts",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Accept", "value": "application/json" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/posts",
                    "host": [ "{{baseUrl}}" ],
                    "path": [ "api", "posts" ]
                }
            },
            "response": []
        },
        {
            "name": "Show Post (by {{id}})",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Accept", "value": "application/json" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/posts/{{id}}",
                    "host": [ "{{baseUrl}}" ],
                    "path": [ "api", "posts", "{{id}}" ]
                }
            },
            "response": []
        },
        {
            "name": "Update Post (owner only)",
            "request": {
                "method": "PUT",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Updated title\",\n  \"body\": \"Updated body\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/posts/{{id}}",
                    "host": [ "{{baseUrl}}" ],
                    "path": [ "api", "posts", "{{id}}" ]
                }
            },
            "response": []
        },
        {
            "name": "Delete Post (soft delete; owner only)",
            "request": {
                "method": "DELETE",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/posts/{{id}}",
                    "host": [ "{{baseUrl}}" ],
                    "path": [ "api", "posts", "{{id}}" ]
                }
            },
            "response": []
        },
        {
            "name": "Restore Post (owner only)",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/posts/{{id}}/restore",
                    "host": [ "{{baseUrl}}" ],
                    "path": [ "api", "posts", "{{id}}", "restore" ]
                }
            },
            "response": []
        },
        {
            "name": "Logout (if implemented)",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/logout",
                    "host": [ "{{baseUrl}}" ],
                    "path": [ "api", "logout" ]
                }
            },
            "response": []
        }
    ],
    "variable": [
        { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
        { "key": "token", "value": "" },
        { "key": "id", "value": "" }
    ]
}
