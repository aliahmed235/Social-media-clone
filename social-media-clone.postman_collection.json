{
    "info": {
        "name": "Social Media Clone API (Sanctum, Policies, Soft Delete, Webhook DTO + Signed)",
        "_postman_id": "3b6d8b3a-7c9f-4c34-9a0b-aaa000111222",
        "description": "Laravel Sanctum Token Auth — Signup, Login (captures token), Create Post (captures id), List/Show, Update, Delete (soft), Restore, Webhook Post with DTO mapping and HMAC signature headers.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Signup",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "pm.test('Status is 201 or 200', function () {",
                            "  pm.expect(pm.response.code).to.be.oneOf([200,201]);",
                            "});",
                            "pm.test('Response includes token', function () {",
                            "  pm.expect(json).to.have.property('token');",
                            "});",
                            "if (json.token) {",
                            "  pm.collectionVariables.set('token', json.token);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Ali Ahmed\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"Secret123!\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/signup",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "signup"]
                }
            },
            "response": []
        },
        {
            "name": "Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "pm.test('Status is 200', function () {",
                            "  pm.expect(pm.response.code).to.eql(200);",
                            "});",
                            "pm.test('Response includes token', function () {",
                            "  pm.expect(json).to.have.property('token');",
                            "});",
                            "if (json.token) {",
                            "  pm.collectionVariables.set('token', json.token);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"ali@example.com\",\n  \"password\": \"Secret123!\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/login",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "login"]
                }
            },
            "response": []
        },
        {
            "name": "Create Post",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "pm.test('Status is 201 or 200', function () {",
                            "  pm.expect(pm.response.code).to.be.oneOf([200,201]);",
                            "});",
                            "let id = json.id || (json.post && json.post.id) || (Array.isArray(json) && json[0] && json[0].id) || null;",
                            "if (id) {",
                            "  pm.collectionVariables.set('id', id);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"My First Post\",\n  \"body\": \"Hello World!\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/posts",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "posts"]
                }
            },
            "response": []
        },
        {
            "name": "List Posts",
            "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                    "raw": "{{baseUrl}}/api/posts",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "posts"]
                }
            },
            "response": []
        },
        {
            "name": "Show Post (by {{id}})",
            "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                    "raw": "{{baseUrl}}/api/posts/{{id}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "posts", "{{id}}"]
                }
            },
            "response": []
        },
        {
            "name": "Update Post (owner only)",
            "request": {
                "method": "PUT",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Updated title\",\n  \"body\": \"Updated body\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/posts/{{id}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "posts", "{{id}}"]
                }
            },
            "response": []
        },
        {
            "name": "Delete Post (soft delete; owner only)",
            "request": {
                "method": "DELETE",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/posts/{{id}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "posts", "{{id}}"]
                }
            },
            "response": []
        },
        {
            "name": "Restore Post (owner only)",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/posts/{{id}}/restore",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "posts", "{{id}}", "restore"]
                }
            },
            "response": []
        },
        {
            "name": "Webhook: Create Post (Signed)",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "// Build timestamp (seconds) and raw body string",
                            "const timestamp = Math.floor(Date.now() / 1000).toString();",
                            "const rawBody = pm.request.body && pm.request.body.raw ? pm.request.body.raw : '';",
                            "",
                            "// Secret must match your .env PARTNER_WEBHOOK_SECRET",
                            "const secret = pm.collectionVariables.get('webhook_secret') || 'superlongrandomsharedsecret';",
                            "",
                            "// Compute HMAC-SHA256 over \"{timestamp}.{rawBody}\"",
                            "const payload = `${timestamp}.${rawBody}`;",
                            "const signature = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
                            "",
                            "// Set/overwrite headers",
                            "pm.request.headers.upsert({ key: 'X-Webhook-Timestamp', value: timestamp });",
                            "pm.request.headers.upsert({ key: 'X-Webhook-Signature', value: signature });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Webhook Test Post\",\n  \"body\": \"This post came from a webhook.\",\n  \"user_id\": 1,\n  \"source\": \"partner\",\n  \"external_event_id\": \"evt-12345\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/webhooks/posts",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "webhooks", "posts"]
                }
            },
            "response": []
        },
        {
            "name": "Logout (if implemented)",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/logout",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "logout"]
                }
            },
            "response": []
        }
    ],
    "variable": [
        { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
        { "key": "token", "value": "" },
        { "key": "id", "value": "" },
        { "key": "webhook_secret", "value": "superlongrandomsharedsecret" }
    ]
}
